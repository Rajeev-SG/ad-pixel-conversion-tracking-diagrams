    {
      "id": "note1",
      "type": "text",
      "x": 60,
      "y": 950,
      "width": 900,
      "height": 45,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 13,
      "frameId": null,
      "groupIds": [],
      "index": "a38",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Note: cookies and click IDs only work if the tag is on every page the user visits — gaps in coverage break attribution.\nMeta also supports server-side CAPI with hashed email/phone for cross-device matching when browser cookies are limited.",
      "roughness": 1,
      "roundness": null,
      "seed": 944030556,
      "strokeColor": "#5c6773",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Note: cookies and click IDs only work if the tag is on every page the user visits — gaps in coverage break attribution.\nMeta also supports server-side CAPI with hashed email/phone for cross-device matching when browser cookies are limited.",
      "textAlign": "center",
      "updated": 1790287291883,
      "version": 1,
      "versionNonce": 1395275862,
      "verticalAlign": "middle"
    },
