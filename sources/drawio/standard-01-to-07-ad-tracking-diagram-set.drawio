;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="820" y="720" width="200" height="130" as="geometry"/></mxCell><mxCell id="n14" value="CONVERSION&lt;br&gt;RECORDED&lt;br&gt;in Ads Manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1080" y="720" width="170" height="130" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lg" value="Solid = sequence. Conversion data feeds back into the algorithm (see red note in D2)." style="text;html=1;fontSize=12;fontColor=#5c6773;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="700" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="D2 — Conversion Signal Flow"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1300"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Conversion Signal Flow — From Click to Recorded Conversion" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1971c2;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/></mxCell><mxCell id="t2" value="How the ad platform connects a browser-side action back to a specific ad click" style="text;html=1;fontSize=12;fontColor=#5c6773;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1200" height="30" as="geometry"/></mxCell><mxCell id="z1" value="STEPS 1-4  THE CLICK JOURNEY (user + platform)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e8f0fe;strokeColor=#1967d2;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1240" height="340" as="geometry"/></mxCell><mxCell id="z2" value="STEPS 5-8  THE CONVERSION JOURNEY (tags + platform backend)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e6f4ea;strokeColor=#188038;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="1240" height="340" as="geometry"/></mxCell><mxCell id="z3" value="STEPS 9-10  THE LEARNING LOOP (how the algorithm uses the data)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fef7e0;strokeColor=#e37400;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1240" height="260" as="geometry"/></mxCell><mxCell id="b1" value="AD CLICK&lt;br&gt;User clicks on ad&lt;br&gt;in the platform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="180" height="150" as="geometry"/></mxCell><mxCell id="b2" value="CLICK ID APPENDED&lt;br&gt;gclid / fbclid / ttclid&lt;br&gt;added to destination URL&lt;br&gt;(unique per click)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="300" y="190" width="220" height="150" as="geometry"/></mxCell><mxCell id="b3" value="USER LANDS&lt;br&gt;Landing page loads&lt;br&gt;URL carries the&lt;br&gt;click ID param" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="570" y="190" width="200" height="150" as="geometry"/></mxCell><mxCell id="b4" value="CLICK ID STORED&lt;br&gt;First-party cookie:&lt;br&gt;_gcl_aw (Google)&lt;br&gt;_fbp (Meta) / _ttp (TikTok)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="820" y="190" width="220" height="150" as="geometry"/></mxCell><mxCell id="b5" value="CONVERSION EVENT&lt;br&gt;User completes a desired&lt;br&gt;action (purchase, signup,&lt;br&gt;lead)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="200" height="150" as="geometry"/></mxCell><mxCell id="b6" value="EVENT TAG FIRES&lt;br&gt;Pixel / gtag sends event&lt;br&gt;+ stored click ID&lt;br&gt;+ event_id for dedup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="320" y="560" width="210" height="150" as="geometry"/></mxCell><mxCell id="b7" value="SERVER-SIDE MATCH&lt;br&gt;CAPI / Events API adds&lt;br&gt;hashed email or phone&lt;br&gt;for cross-device match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="580" y="560" width="220" height="150" as="geometry"/></mxCell><mxCell id="b8" value="ATTRIBUTION WINDOW&lt;br&gt;Platform matches event&lt;br&gt;to click within window&lt;br&gt;(7 / 30 / 90 days or&lt;br&gt;view-through)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="850" y="560" width="220" height="150" as="geometry"/></mxCell><mxCell id="b9" value="CONVERSION RECORDED&lt;br&gt;in Ads Manager&lt;br&gt;Campaign ▸ Ad Set ▸ Ad&lt;br&gt;has performance data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="70" y="930" width="220" height="150" as="geometry"/></mxCell><mxCell id="b10" value="ALGORITHM UPDATES&lt;br&gt;Bids, lookalikes, creative&lt;br&gt;delivery shift based on&lt;br&gt;new conversion signal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="340" y="930" width="230" height="150" as="geometry"/></mxCell><mxCell id="b11" value="BETTER TARGETING&lt;br&gt;Next auctions serve ads&lt;br&gt;to users who look like&lt;br&gt;the people who converted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="620" y="930" width="230" height="150" as="geometry"/></mxCell><mxCell id="b12" value="BETTER ROAS&lt;br&gt;Lower cost per&lt;br&gt;conversion over time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="900" y="930" width="180" height="150" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="b10" target="b11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="b11" target="b12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Learning loop only becomes meaningful once conversion signal accumulates (typically 30-50 conversions per ad set for Meta, 30 per month for Google)." style="text;html=1;fontSize=11;fontColor=#5c6773;" vertex="1" parent="1"><mxGeometry x="70" y="1100" width="800" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="D3 — Algorithm Learning Loop"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1300"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="How the Algorithm Learns — Conversion Data → Smarter Bidding" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1971c2;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/></mxCell><mxCell id="t2" value="Every recorded conversion is a training example that shifts the next auction" style="text;html=1;fontSize=12;fontColor=#5c6773;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1200" height="30" as="geometry"/></mxCell><mxCell id="z1" value="1  SIGNAL ACCUMULATION  (the platform collects examples)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e6f4ea;strokeColor=#188038;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1240" height="200" as="geometry"/></mxCell><mxCell id="z2" value="2  PATTERN LEARNING  (the model finds what works)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e8f0fe;strokeColor=#1967d2;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1240" height="220" as="geometry"/></mxCell><mxCell id="z3" value="3  AUCTION-LEVEL OPTIMISATION  (every impression)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fef7e0;strokeColor=#e37400;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1240" height="220" as="geometry"/></mxCell><mxCell id="z4" value="4  MEASURABLE OUTCOME  (what you see in reporting)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fce8e6;strokeColor=#d93025;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1240" height="200" as="geometry"/></mxCell><mxCell id="c1" value="Conversion events stream&lt;br&gt;in with click IDs and&lt;br&gt;user context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="260" height="100" as="geometry"/></mxCell><mxCell id="c2" value="Device, location, time,&lt;br&gt;browser, creative attached&lt;br&gt;to each event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="180" width="250" height="100" as="geometry"/></mxCell><mxCell id="c3" value="Data grouped by campaign,&lt;br&gt;ad set, ad, and audience" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="690" y="180" width="250" height="100" as="geometry"/></mxCell><mxCell id="c4" value="Model learns: people like&lt;br&gt;this, at this time, from&lt;br&gt;this creative, tend to&lt;br&gt;convert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="410" width="260" height="120" as="geometry"/></mxCell><mxCell id="c5" value="Builds lookalike and&lt;br&gt;similar-audience seeds&lt;br&gt;from converters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="410" width="250" height="120" as="geometry"/></mxCell><mxCell id="c6" value="Learns which search queries,&lt;br&gt;interests and placements&lt;br&gt;drive value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="690" y="410" width="250" height="120" as="geometry"/></mxCell><mxCell id="c7" value="Bid raised for auctions that&lt;br&gt;look likely to convert;&lt;br&gt;lowered for those that&lt;br&gt;don't" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="660" width="260" height="120" as="geometry"/></mxCell><mxCell id="c8" value="Ad delivery weighted toward&lt;br&gt;users who resemble&lt;br&gt;converters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="660" width="250" height="120" as="geometry"/></mxCell><mxCell id="c9" value="Poor-performing queries or&lt;br&gt;placements get suppressed&lt;br&gt;over time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="690" y="660" width="250" height="120" as="geometry"/></mxCell><mxCell id="c10" value="Cost per conversion falls;&lt;br&gt;conversion volume rises" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d93025;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="910" width="260" height="100" as="geometry"/></mxCell><mxCell id="c11" value="ROAS and CPA improve&lt;br&gt;across campaigns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d93025;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="910" width="250" height="100" as="geometry"/></mxCell><mxCell id="c12" value="Learning is faster when&lt;br&gt;signal is clean and&lt;br&gt;unfragmented" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d93025;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="690" y="910" width="250" height="100" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="D4 — Cookies &amp; Click IDs"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1300"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Cookies &amp;amp; Click IDs Deep Dive — What Gets Dropped and Why" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1971c2;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/></mxCell><mxCell id="t2" value="The technical glue between an ad click and a website conversion" style="text;html=1;fontSize=12;fontColor=#5c6773;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1200" height="30" as="geometry"/></mxCell><mxCell id="z1" value="URL PARAMETERS  (added to the destination URL on ad click)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e8f0fe;strokeColor=#1967d2;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1240" height="270" as="geometry"/></mxCell><mxCell id="z2" value="FIRST-PARTY COOKIES  (set by the tag on the website's domain)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e6f4ea;strokeColor=#188038;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1240" height="270" as="geometry"/></mxCell><mxCell id="z3" value="MATCHING AT CONVERSION  (how the tag links back to the ad)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fef7e0;strokeColor=#e37400;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="1240" height="250" as="geometry"/></mxCell><mxCell id="p1" value="gclid  (Google)&lt;br&gt;Appended by auto-tagging.&lt;br&gt;Unique per ad click." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="250" height="150" as="geometry"/></mxCell><mxCell id="p2" value="fbclid  (Meta)&lt;br&gt;Appended on click.&lt;br&gt;Captured by Pixel; feeds&lt;br&gt;the fbc parameter." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="190" width="250" height="150" as="geometry"/></mxCell><mxCell id="p3" value="ttclid  (TikTok)&lt;br&gt;Appended on click.&lt;br&gt;Captured by TikTok Pixel&lt;br&gt;for attribution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="190" width="250" height="150" as="geometry"/></mxCell><mxCell id="k1" value="_gcl_aw  (Google)&lt;br&gt;Stores GCLID in a first-,&lt;br&gt;party cookie. 30-day&lt;br&gt;expiry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="490" width="250" height="150" as="geometry"/></mxCell><mxCell id="k2" value="_fbp  (Meta)&lt;br&gt;Browser/device ID cookie.&lt;br&gt;Feeds the fbp parameter." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="490" width="250" height="150" as="geometry"/></mxCell><mxCell id="k3" value="_ttp  (TikTok)&lt;br&gt;TikTok cookie ID for&lt;br&gt;matching browser events&lt;br&gt;to clicks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="490" width="250" height="150" as="geometry"/></mxCell><mxCell id="m1" value="Pixel / gtag reads click&lt;br&gt;ID from cookie at&lt;br&gt;conversion time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="790" width="250" height="130" as="geometry"/></mxCell><mxCell id="m2" value="Sends it with the&lt;br&gt;conversion event&lt;br&gt;(event_id for dedup)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="790" width="250" height="130" as="geometry"/></mxCell><mxCell id="m3" value="Platform matches event to&lt;br&gt;ad click within attribution&lt;br&gt;window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="790" width="250" height="130" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="k2" target="k3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="p1" target="k1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="p2" target="k2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="p3" target="k3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="k1" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="k2" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="k3" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="D5 — Tag Setup"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1300"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Tag Setup Deep Dive — What Goes Where on the Site" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1971c2;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/></mxCell><mxCell id="t2" value="Practical layout of base tags, event tags, and server-side layers" style="text;html=1;fontSize=12;fontColor=#5c6773;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1200" height="30" as="geometry"/></mxCell><mxCell id="z1" value="SITELINE 1  EVERY PAGE &amp;lt;head&amp;gt;  (fire on load)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e8f0fe;strokeColor=#1967d2;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1240" height="240" as="geometry"/></mxCell><mxCell id="z2" value="SITELINE 2  CONVERTING PAGES ONLY  (fire on user action)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e6f4ea;strokeColor=#188038;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="1240" height="240" as="geometry"/></mxCell><mxCell id="z3" value="SITELINE 3  SERVER-SIDE LAYER  (optional but increasingly standard)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fef7e0;strokeColor=#e37400;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1240" height="240" as="geometry"/></mxCell><mxCell id="q1" value="GOOGLE&lt;br&gt;Google Tag (gtag.js) or GTM&lt;br&gt;container + Google Ads&lt;br&gt;conversion linker tag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="350" height="130" as="geometry"/></mxCell><mxCell id="q2" value="META&lt;br&gt;Meta Pixel (fbevents.js) or&lt;br&gt;GTM container with Meta base&lt;br&gt;tag + Advanced Matching" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="480" y="180" width="350" height="130" as="geometry"/></mxCell><mxCell id="q3" value="TIKTOK&lt;br&gt;TikTok Pixel (ttq.js) or GTM&lt;br&gt;container with TikTok base tag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="880" y="180" width="350" height="130" as="geometry"/></mxCell><mxCell id="r1" value="GOOGLE&lt;br&gt;Google Ads conversion tag fired&lt;br&gt;by trigger (submit, click, page&lt;br&gt;view on thank-you URL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="450" width="350" height="130" as="geometry"/></mxCell><mxCell id="r2" value="META&lt;br&gt;Standard event (Purchase, Lead,&lt;br&gt;AddToCart) fired by trigger or&lt;br&gt;helper tag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="480" y="450" width="350" height="130" as="geometry"/></mxCell><mxCell id="r3" value="TIKTOK&lt;br&gt;Standard event fired by trigger&lt;br&gt;(PlaceOrder, SubmitForm,&lt;br&gt;CompleteRegistration)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="880" y="450" width="350" height="130" as="geometry"/></mxCell><mxCell id="s1" value="GOOGLE&lt;br&gt;Google Tag via Server-side GTM&lt;br&gt;+ Enhanced Conversions&lt;br&gt;(hashed email)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="720" width="350" height="130" as="geometry"/></mxCell><mxCell id="s2" value="META&lt;br&gt;Conversions API (CAPI) sends&lt;br&gt;events from server + event_id&lt;br&gt;dedup with browser pixel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="480" y="720" width="350" height="130" as="geometry"/></mxCell><mxCell id="s3" value="TIKTOK&lt;br&gt;Events API sends server-side&lt;br&gt;events + event_id dedup with&lt;br&gt;browser pixel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="880" y="720" width="350" height="130" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="q2" target="q3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="D6 — Attribution Deep Dive"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1300"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Attribution Deep Dive — How the Platform Decides 'This Conversion Came From That Ad'" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1971c2;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/></mxCell><mxCell id="t2" value="Windows, dedup, and what happens when signals are missing" style="text;html=1;fontSize=12;fontColor=#5c6773;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1200" height="30" as="geometry"/></mxCell><mxCell id="z1" value="THE MATCH RULES  (what qualifies a conversion to an ad)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e8f0fe;strokeColor=#1967d2;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1240" height="240" as="geometry"/></mxCell><mxCell id="z2" value="DEDUPLICATION  (the same conversion counted once)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e6f4ea;strokeColor=#188038;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="1240" height="240" as="geometry"/></mxCell><mxCell id="z3" value="GAPS &amp;amp; FALLBACKS  (what happens when signals are weak or missing)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fef7e0;strokeColor=#e37400;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1240" height="240" as="geometry"/></mxCell><mxCell id="h1" value="Click ID match&lt;br&gt;Stored gclid/fbclid/ttclid on&lt;br&gt;the conversion event&lt;br&gt;matches a known click" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="350" height="130" as="geometry"/></mxCell><mxCell id="h2" value="Attribution window&lt;br&gt;Match accepted only if&lt;br&gt;conversion falls inside&lt;br&gt;the set window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="480" y="180" width="350" height="130" as="geometry"/></mxCell><mxCell id="h3" value="Last-touch / data-driven&lt;br&gt;Google uses data-driven&lt;br&gt;attribution by default; Meta&lt;br&gt;uses last-click for ad set&lt;br&gt;reporting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1967d2;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="880" y="180" width="350" height="130" as="geometry"/></mxCell><mxCell id="h4" value="Event dedup&lt;br&gt;Same event_id from browser&lt;br&gt;pixel + CAPI counted once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="450" width="350" height="130" as="geometry"/></mxCell><mxCell id="h5" value="Order-independent&lt;br&gt;Dedup is not 'first one wins' —&lt;br&gt;it's a join on event_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="480" y="450" width="350" height="130" as="geometry"/></mxCell><mxCell id="h6" value="Why it matters&lt;br&gt;Prevents double-counting and&lt;br&gt;keeps reported conversion&lt;br&gt;volume accurate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="880" y="450" width="350" height="130" as="geometry"/></mxCell><mxCell id="h7" value="Modelled conversions&lt;br&gt;When signals are missing,&lt;br&gt;platform estimates conversions&lt;br&gt;from similar users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="720" width="350" height="130" as="geometry"/></mxCell><mxCell id="h8" value="Consent mode / privacy&lt;br&gt;GDPR consent can withhold&lt;br&gt;browser signals; server-side&lt;br&gt;layer fills gap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="480" y="720" width="350" height="130" as="geometry"/></mxCell><mxCell id="h9" value="Signal quality&lt;br&gt;Clean dedup + valid click IDs =&lt;br&gt;better attribution = better&lt;br&gt;algorithm learning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e37400;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="880" y="720" width="350" height="130" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="h2" target="h3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="h4" target="h5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="h5" target="h6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="h7" target="h8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="h8" target="h9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Attribution windows (Google: 30-day click / Meta: 7-day click 1-day view by default) determine how long a click ID stays valid for matching." style="text;html=1;fontSize=11;fontColor=#5c6773;" vertex="1" parent="1"><mxGeometry x="80" y="930" width="1000" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>