<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" modified="2026-09-24T00:00:00.000Z" agent="codex" version="31.4.2"><diagram name="D0 — Master View"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1150"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Master View — End-to-End Ad Conversion &amp; Optimisation Loop" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1971c2;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="40" as="geometry"/></mxCell><mxCell id="t2" value="Every actor, signal, and handoff from campaign launch through algorithm optimisation" style="text;html=1;fontSize=12;fontColor=#5c6773;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1600" height="25" as="geometry"/></mxCell><mxCell id="z1" value="1  CAMPAIGN SETUP  (advertiser configures, platform stores)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e8f0fe;strokeColor=#1967d2;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1560" height="210" as="geometry"/></mxCell><mxCell id="z2" value="2  TAG DEPLOYMENT  (site infrastructure, built once)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e6f4ea;strokeColor=#188038;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1560" height="210" as="geometry"/></mxCell><mxCell id="z3" value="3  LIVE TRAFFIC  (what actually happens when the ad runs)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fef7e0;strokeColor=#e37400;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1560" height="210" as="geometry"/></mxCell><mxCell id="z4" value="4  CONVERSION &amp; FEEDBACK  (platform records, algorithm adapts)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fill