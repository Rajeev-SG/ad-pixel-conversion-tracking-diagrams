ve affinity refined" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d93025;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="740" y="890" width="260" height="120" as="geometry"/></mxCell><mxCell id="n21" value="NEXT AUCTION SMARTER&lt;br&gt;Bid raised for users who&lt;br&gt;resemble converters; poor&lt;br&gt;performers suppressed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d93025;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1050" y="890" width="260" height="120" as="geometry"/></mxCell><mxCell id="n22" value="BETTER ROAS&lt;br&gt;Lower cost per conversion;&lt;br&gt;campaign scales to more volume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d93025;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1360" y="890" width="220" height="120" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdge